{
  "name": "psl-detailer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "build": "vite build && node scripts-build-sw.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "setup": "node --env-file-if-exists=.env server/setup.js",
    "seed:demo": "node --env-file-if-exists=.env server/setup.js --demo",
    "test": "node --test test/*.test.js",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "fake-indexeddb": "^6.0.0",
    "vite": "^6.3.5"
  }
}
